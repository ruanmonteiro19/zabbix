$version="7.2.13"
$arch="amd64"
$url="https://cdn.zabbix.com/zabbix/binaries/stable/7.2/$version/zabbix_agent2-$version-windows-$arch-openssl.msi"
$dest="$env:TEMP\zabbix_agent2-$version.msi"
$server="10.4.0.61"

if(Get-Service -Name "Zabbix Agent" -ErrorAction SilentlyContinue){
    Stop-Service "Zabbix Agent" -Force
    Get-WmiObject Win32_Product | Where-Object{$_.Name -like "*Zabbix Agent*"} | ForEach-Object{
        Start-Process "msiexec.exe" -Wait -ArgumentList "/x $($_.IdentifyingNumber) /qn"
    }
}

if(Get-Service -Name "Zabbix Agent 2" -ErrorAction SilentlyContinue){
    Stop-Service "Zabbix Agent 2" -Force
}

Invoke-WebRequest -Uri $url -OutFile $dest -UseBasicParsing

Start-Process "msiexec.exe" -Wait -ArgumentList "/i `"$dest`" /qn /norestart SERVER=$server SERVERACTIVE=$server HOSTNAME=$env:COMPUTERNAME ENABLEPATH=1"
Start-Sleep -s 5

# Caminho do arquivo de configuração
$configPath = "C:\Program Files\Zabbix Agent 2\zabbix_agent2.conf"

# Adiciona ou substitui o campo HostMetaData
if (Test-Path $configPath) {
    (Get-Content $configPath) |
        ForEach-Object {
            if ($_ -match "^HostMetaData=") {
                "HostMetaData=linux"
            } else {
                $_
            }
        } | Set-Content $configPath

    # Se o campo não existir, adiciona no final
    if (-not (Select-String -Path $configPath -Pattern "^HostMetaData=")) {
        Add-Content -Path $configPath -Value "`nHostMetaData=linux"
    }
}

Start-Service "Zabbix Agent 2"
& "C:\Program Files\Zabbix Agent 2\zabbix_agent2.exe" --version
